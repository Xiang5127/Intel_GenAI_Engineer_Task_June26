{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Intel Local Video AI",
  "version": "0.1.0",
  "identifier": "com.intel.local-video-ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Intel Local Video AI",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
